{
    "name": "tonetlds/alfredapp",
    "description": "Alfred App.",
    "keywords": [
        "crm",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "barryvdh/laravel-dompdf": "^0.6.1",
        "doctrine/dbal": "^2.5",
        "fzaninotto/faker": "v1.3.0",
        "guzzlehttp/guzzle": "^6.0",
        "laravel/framework": "5.0.*",
        "laravelcollective/html": "^5.0",
        "zizaco/confide": "4.3.0"
    },
    "autoload": {
        "classmap": [
            "app/Console/Commands",
            "app/Http/Controllers",
            "app/models",
            "database/migrations",
            "database/seeds",
            "tests/TestCase.php",
            "app/lib"
        ],
        "files": [
            "app/functions/aboutdate.php",
            "app/functions/fazmerir.php",
            "app/functions/saudacoes.php"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php artisan key:generate"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "audit": {
            "block-insecure": false,
            "abandoned": "ignore"
        },
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "minimum-stability": "stable",
    "require-dev": {}
}
